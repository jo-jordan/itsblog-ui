{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itsblog",
  "compatibility_date": "2026-10-08",
  // Tiny Worker in front of the static Vue build: only redirects www to the apex.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./itsblog-ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Cloudflare creates the DNS records and certificates on deploy.
  // Existing DNS records for these hostnames must be deleted first.
  "routes": [
    { "pattern": "edgeless.me", "custom_domain": true },
    { "pattern": "www.edgeless.me", "custom_domain": true }
  ]
}
