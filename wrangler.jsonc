{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itsblog",
  "compatibility_date": "2026-10-08",
  // Worker in front of the static Vue build: www redirect, footprints API, photos.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./itsblog-ui",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itsblog-db",
      "database_id": "eab86132-a239-4c6f-aedc-cb6697e9ecb7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "itsblog-media" }
  ],
  "observability": { "enabled": true },
  // Cloudflare creates the DNS records and certificates on deploy.
  // Existing DNS records for these hostnames must be deleted first.
  "routes": [
    { "pattern": "edgeless.me", "custom_domain": true },
    { "pattern": "www.edgeless.me", "custom_domain": true }
  ]
}
